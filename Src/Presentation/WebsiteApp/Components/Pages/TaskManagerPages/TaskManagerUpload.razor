@page "/taskmanagerupload"

@using Application.Aggregates.TaskItemAggregate.Commands.CreateUpdate
@using Application.Aggregates.TaskListAggregate.Commands.CreateUpdate
@using Application.Common.Models
@using Newtonsoft.Json
@using WebsiteApp.Services
@using Microsoft.AspNetCore.SignalR.Client

@inject IWebApiService<CreateTaskListRequest, CreateTaskListResponse> _taskListService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IConfiguration Configuration

@implements IDisposable
@rendermode InteractiveServer


<RadzenCard Variant="Variant.Outlined">
    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Select a file to upload and click Upload</RadzenText>
    <RadzenUpload Auto="false" Multiple="false"
                  Change="@OnFileSelected"
                  Style="width: 100%" />
    <RadzenButton Text="Upload" Click=@OnUpload class="rz-mt-4" />
</RadzenCard>

<RadzenCard>
    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.H4">@message</RadzenText>
</RadzenCard>

<p>Connection status: @_hubConnection?.State.ToString()</p>

@foreach (var requestId in allRequestIds)
{
    <h4>Request: @requestId</h4>
    <p>Hub Status: @_hubConnection?.State.ToString()</p>

    <ul>
        @if (createTaskListResponses != null)
        {
            @foreach (var item in createTaskListResponses)
            {
                @if (@item.CustomError.isSuccess)
                {
                    <p>@item.RowId + " - " + @item.CustomError.isSuccess.ToString()</p>
                }
                else
                {
                    <p>@item.RowId + " - " + @item.CustomError.error </p>
                }
            }
        }
        else
        {
            <li><em>Waiting for result...</em></li>
        }
    </ul>
}


@code {

    private IBrowserFile selectedFile;
    private string message;
    private HubConnection? _hubConnection;

    private string requestId { get; set; }

    const int MAX_FILE_SIZE = 1024 * 1024 * 10; // 10 MB

    private List<CreateTaskListResponse> createTaskListResponses = new List<CreateTaskListResponse>();
    private CancellationTokenSource? _cts = new(TimeSpan.FromMinutes(5));
    private string? apiUrl;

    private void OnFileSelected(UploadChangeEventArgs e)
    {
        selectedFile = e.Files.FirstOrDefault();
        message = selectedFile == null ? "No file selected." : null;
    }

    public record InvalidRow(int RowId, string Title, string ErrorMessage);
    private List<string> allRequestIds = new();

    protected override async Task OnInitializedAsync()
    {
        apiUrl = Configuration["AppSettings:ApiUrl"];

        _hubConnection = new HubConnectionBuilder()
       .WithUrl($"{apiUrl}/processHub")
       .WithAutomaticReconnect()
       .Build();


        _hubConnection.Closed += error =>
        {
            Console.WriteLine("🔴 Connection closed.");
            if (error != null) Console.WriteLine(error.Message);

            return Task.CompletedTask;
        };


        _hubConnection.Reconnecting += error =>
        {
            Console.WriteLine("🟡 Reconnecting...");
            return Task.CompletedTask;
        };

        _hubConnection.Reconnected += connectionId =>
        {
            Console.WriteLine($"🟢 Reconnected with connectionId: {connectionId}");
            return Task.CompletedTask;
        };

        // Setup message handlers
        _hubConnection.On<string, List<CreateTaskListResponse>>("TaskCompleted", (id, data) =>
        {
            Console.WriteLine($"📨 Message received for requestId: {id}");
            if (id == requestId)
            {
                //data.IsSuccess
                createTaskListResponses = data;
                InvokeAsync(StateHasChanged);
            }
            return Task.CompletedTask;
        });

        await _hubConnection.StartAsync();
        Console.WriteLine("✅ SignalR connection started.");
    }


 

    public async Task OnUpload()
    {
        try
        {
            if (selectedFile == null)
            {
                Console.WriteLine("No file selected.");
                return;
            }


            using var reader = new StreamReader(selectedFile.OpenReadStream(MAX_FILE_SIZE));


            var validItems = new List<CreateTaskListRequest>();
            var invalidRows = new List<InvalidRow>();

            bool isFirstLine = true;
            string line;
            int rowId = 1;

            _cts = new CancellationTokenSource();
            var cancellationToken = _cts.Token;

            while ((line = await reader.ReadLineAsync()) != null)
            {
                if (isFirstLine)
                {
                    isFirstLine = false; // skip header
                    continue;
                }

                var result = await ParseCsvLineAsync(rowId, line);
                if (result.IsSuccess)
                {
                    // If the title already exists, add the task items to the existing task list
                    var existingItem = validItems.FirstOrDefault(t => t.Title == result.Value.Title);

                    if (existingItem is not null)
                    {
                        existingItem.createTaskItemRequests.AddRange(result.Value.createTaskItemRequests);
                    }
                    else
                    {
                        validItems.Add(result.Value!);
                    }

                    rowId++;
                }
                else
                {
                    invalidRows.Add(new InvalidRow(rowId++, line.Substring(0, line.Length >= 10 ? 10 : line.Length), result.CustomError.error));
                }

                if (validItems.Count == 10)
                {
                    var apiReturn = await _taskListService.SaveBulkV2Async($"tasklist/bulk", validItems, cancellationToken);

                    var demodemo = await apiReturn.Content.ReadFromJsonAsync<Dictionary<string, string>>();

                    requestId = demodemo["requestId"];
                    allRequestIds.Add(requestId);

                    if (_hubConnection?.State == HubConnectionState.Connected)
                    {
                        await _hubConnection.SendAsync("JoinGroup", requestId);
                    }
                }
            }

            // Send remaining items
            if (validItems.Any())
            {
                var apiReturn = await _taskListService.SaveBulkV2Async($"tasklist/bulk", validItems, cancellationToken);

                var demodemo = await apiReturn.Content.ReadFromJsonAsync<Dictionary<string, string>>();

                requestId = demodemo["requestId"];
                allRequestIds.Add(requestId);

                if (_hubConnection?.State == HubConnectionState.Connected)
                {
                    await _hubConnection.SendAsync("JoinGroup", requestId);
                }
            }

            message = "CSV uploaded and processingng...";

        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }


    private Task<CustomResult<CreateTaskListRequest?>> ParseCsvLineAsync(int rowId, string line)
    {
        //TaskList -                TaskItem
        //Title, DueDate, AssignTo, Title, Description?

        var parts = line.Split(',');
        if (parts.Length == 5)
        {
            var newTaskList = new CreateTaskListRequest()
            {
                Title = parts[0],
                DueDate = DateOnly.FromDateTime(DateTime.TryParse(parts[1].Trim(), out var dueDate) ? dueDate : DateTime.Now),
                AssignedTo = parts[2].Trim() ?? "",
                createTaskItemRequests = new List<CreateTaskItemRequest>
                {
                    new CreateTaskItemRequest()
                    {
                        RowId = rowId,
                        Title = parts[3].Trim(),
                        Description = parts.Length > 4 ? parts[4].Trim() : null
                    }
                }
            };

            return Task.FromResult<CustomResult<CreateTaskListRequest?>>(CustomResult<CreateTaskListRequest?>.Success(newTaskList));
        }

        // Invalid line
        return Task.FromResult<CustomResult<CreateTaskListRequest?>>(CustomResult<CreateTaskListRequest?>.Failure(new CustomError(false, $"Invalid line {parts.Length}")));
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _hubConnection?.DisposeAsync();
    }
}
