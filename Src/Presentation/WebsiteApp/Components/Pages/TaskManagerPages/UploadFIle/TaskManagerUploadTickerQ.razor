<PageTitle>Task Upload</PageTitle>

<div class="container mt-3">
    <div class="card">
        <div class="card-header">
            <RadzenBreadCrumb>
                <RadzenBreadCrumbItem Path="/home" Text="Home" />
                <RadzenBreadCrumbItem Path="/taskmanageradmin" Text="Task Manager" />
                <RadzenBreadCrumbItem Text="Task Upload" />
            </RadzenBreadCrumb>
        </div>
        <div class="card-header">
            <RadzenCard Variant="Variant.Outlined">

                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Select a file to upload and click Upload</RadzenText>
                <RadzenUpload Auto="false" Multiple="false"
                              Change="@OnFileSelected"
                              Style="width: 100%" />
                <RadzenButton Text="Upload" Click=@OnUpload id="file-submit" class="rz-mt-4" />
            </RadzenCard>
        </div>
        <div class="card-body">
            <RadzenStack Gap="1rem">
                <RadzenDataGrid AllowFiltering="false" AllowColumnResize="true" AllowAlternatingRows="false" 
                                AllowSorting="false" PageSize="15" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
                                Data="@employees" ColumnWidth="300px" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedEmployees>
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(CreateTaskListResponse.RowId)" Title="Task Name" Width="160px" />
                        <RadzenDataGridColumn Property="@nameof(CreateTaskListResponse.CustomError)" Title="Error Name" Width="160px">
                            <Template Context="data">
                                @data.CustomError.error
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </div>
    </div>
</div>

