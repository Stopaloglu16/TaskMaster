    public async Task OnUpload()
    {
        try
        {
            if (selectedFile == null)
            {
                Console.WriteLine("No file selected.");
                return;
            }


            using var reader = new StreamReader(selectedFile.OpenReadStream(MAX_FILE_SIZE));


            var validItems = new List<CreateTaskListRequest>();
            var invalidRows = new List<InvalidRow>();

            bool isFirstLine = true;
            string line;
            int rowId = 1;

            _cts = new CancellationTokenSource();
            var cancellationToken = _cts.Token;

            while ((line = await reader.ReadLineAsync()) != null)
            {
                if (isFirstLine)
                {
                    isFirstLine = false; // skip header
                    continue;
                }

                var result = await ParseCsvLineAsync(rowId, line);
                if (result.IsSuccess)
                {
                    // If the title already exists, add the task items to the existing task list
                    var existingItem = validItems.FirstOrDefault(t => t.Title == result.Value.Title);

                    if (existingItem is not null)
                    {
                        existingItem.createTaskItemRequests.AddRange(result.Value.createTaskItemRequests);
                    }
                    else
                    {
                        validItems.Add(result.Value!);
                    }

                    rowId++;
                }
                else
                {
                    invalidRows.Add(new InvalidRow(rowId++, line.Substring(0, line.Length >= 10 ? 10 : line.Length), result.CustomError.error));
                }

                if (validItems.Count == 10)
                {
                    var apiReturn = await _taskListService.SaveBulkTickerQAsync($"tasklist/BulkTickerQ", validItems, cancellationToken);

                    var demodemo = await apiReturn.Content.ReadFromJsonAsync<Dictionary<string, string>>();

                    //requestId = demodemo["requestId"];
                    //apiReturn.RequestId

                    //allRequestIds.Add(apiReturn..RequestId);

                    // if (_hubConnection?.State == HubConnectionState.Connected)
                    // {
                    //     _connections.Add(_hubConnection);
                    //     await _hubConnection.SendAsync("JoinGroup", requestId);
                    // }

                    validItems.Clear(); // Clear after sending
                }
            }

            // Send remaining items
            if (validItems.Any())
            {
                var apiReturn = await _taskListService.SaveBulkTickerQAsync($"tasklist/BulkTickerQ", validItems, cancellationToken);

                //{ "requestId":"06eaec6d-ca3b-4301-8bd0-bd1722bc1d80"}

                var demodemo = await apiReturn.Content.ReadFromJsonAsync<Dictionary<string, string>>();

                requestId = demodemo["requestId"];
                allRequestIds.Add(requestId);

                // if (_hubConnection?.State == HubConnectionState.Connected)
                // {
                //     _connections.Add(_hubConnection);
                //     await _hubConnection.SendAsync("JoinGroup", requestId);
                // }
            }

            JobsCount = allRequestIds.Count;
            message = "CSV uploaded and processing...";
            await ShowBusyDialog();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }


    private Task<CustomResult<CreateTaskListRequest?>> ParseCsvLineAsync(int rowId, string line)
    {
        var parts = line.Split(',');
        if (parts.Length == 5)
        {
            var newTaskList = new CreateTaskListRequest()
            {
                Title = parts[0],
                DueDate = DateOnly.FromDateTime(DateTime.TryParse(parts[1].Trim(), out var dueDate) ? dueDate : DateTime.Now),
                AssignedTo = parts[2].Trim() ?? "",
                createTaskItemRequests = new List<CreateTaskItemRequest>
                {
                    new CreateTaskItemRequest()
                    {
                        RowId = rowId,
                        Title = parts[3].Trim(),
                        Description = parts.Length > 4 ? parts[4].Trim() : null
                    }
                }
            };

            return Task.FromResult<CustomResult<CreateTaskListRequest?>>(CustomResult<CreateTaskListRequest?>.Success(newTaskList));
        }

        // Invalid line
        return Task.FromResult<CustomResult<CreateTaskListRequest?>>(CustomResult<CreateTaskListRequest?>.Failure(new CustomError(false, $"Invalid line {parts.Length}")));
    }



