    #region FileUpload Process

    public async Task OnUpload()
    {
        try
        {
            if (selectedFile == null)
            {
                Console.WriteLine("No file selected.");
                return;
            }

            //await ShowBusyDialog();

            using var reader = new StreamReader(selectedFile.OpenReadStream(MAX_FILE_SIZE));


            var validItems = new List<CreateFileJobUploadRequest>();
            var invalidRows = new List<InvalidRow>();

            bool isFirstLine = true;
            string line;
            int rowId = 1;

            _cts = new CancellationTokenSource();
            var cancellationToken = _cts.Token;

            while ((line = await reader.ReadLineAsync()) != null)
            {
                if (isFirstLine)
                {
                    isFirstLine = false; // skip header
                    continue;
                }

                var result = await ParseCsvLineAsync(rowId, line);
                if (result.IsSuccess)
                {
                    // If the title already exists, add the task items to the existing task list
                    validItems.Add(result.Value!);

                    rowId++;
                }
                else
                {
                    invalidRows.Add(new InvalidRow(rowId++, line.Substring(0, line.Length >= 10 ? 10 : line.Length), result.CustomError.error));
                }

                if (validItems.Count == 10)
                {
                    var apiReturn = await _fileJobUploadService.SaveBulkFileJobAsync($"fileupload/Bulk", FileJobId, validItems, cancellationToken);

                    if (apiReturn.IsSuccessStatusCode)
                    {
                        FileJobId = await apiReturn.Content.ReadFromJsonAsync<int>();

                    }

                    validItems.Clear(); // Clear after sending
                }
            }

            // Send remaining items
            if (validItems.Any())
            {
                var apiReturn = await _fileJobUploadService.SaveBulkFileJobAsync($"fileupload/Bulk", FileJobId, validItems, cancellationToken);

                if (apiReturn.IsSuccessStatusCode)
                {
                    FileJobId = await apiReturn.Content.ReadFromJsonAsync<int>();

                }
            }

            //JobsCount = allRequestIds.Count;
            message = "CSV uploaded and processing...";

            OnChange(1);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }


    private Task<CustomResult<CreateFileJobUploadRequest?>> ParseCsvLineAsync(int rowId, string line)
    {
        var parts = line.Split(',');
        if (parts.Length == 5)
        {
            var newTaskList = new CreateFileJobUploadRequest()
            {
                TaskTitle = parts[0],
                DueDate = DateOnly.FromDateTime(DateTime.TryParse(parts[1].Trim(), out var dueDate) ? dueDate : DateTime.Now),
                AssignedTo = parts[2].Trim() ?? "",
                Title = parts[3].Trim(),
                Description = parts.Length > 4 ? parts[4].Trim() : null
            };

            return Task.FromResult<CustomResult<CreateFileJobUploadRequest?>>(CustomResult<CreateFileJobUploadRequest?>.Success(newTaskList));
        }

        // Invalid line
        return Task.FromResult<CustomResult<CreateFileJobUploadRequest?>>(CustomResult<CreateFileJobUploadRequest?>.Failure(new CustomError(false, $"Invalid line {parts.Length}")));
    }

    #endregion


    #region Validate

    private async Task LoadData(LoadDataArgs args)
    {
        try
        {
            isLoading = true;
            itemsPerPage = args.Top ?? 10;

            int pageNumber = ((int)args.Skip / itemsPerPage) + 1;

            var response = await _fileJobGetService.GetPagingDataAsync(
            $"fileupload?FileJobId={FileJobId}&PageNumber={pageNumber}&PageSize={itemsPerPage}&OrderBy=Id&IsDescending=false",
            _cts.Token);

            if (response != null)
            {
                totalItemCount = response.TotalCount;

                fileJobUploadDtos = response.Items.AsODataEnumerable();
                // Return the grid data
                fileJobUploadDtoList = response.Items;
            }
            else
            {
                // Log or handle the null response scenario
                Console.Error.WriteLine("Failed to load task list data. API returned null.");
            }

            isLoading = false;
        }
        catch (Exception ex)
        {
            NotificationMessage errorMessage = new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Failed to load data: {ex.Message}",
                Duration = 4000
            };
        }
    }


