@page "/taskmanagerUploadFile/{FileJobId:int}"

@using Application.Aggregates.FileJobAggregate.Commands
@using Application.Aggregates.FileJobAggregate.Queries
@using Application.Common.Models
@using Newtonsoft.Json
@using System.Text
@using WebsiteApp.Services
@using Microsoft.AspNetCore.SignalR.Client

@inject IWebApiService<CreateFileJobUploadRequest, int> _fileJobUploadService
@inject IWebApiService<CreateFileJobUploadRequest, FileJobUploadDto> _fileJobGetService
@inject IWebApiService<int, Dictionary<string, int>> _fileJobStatusService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject DialogService DialogService

@implements IDisposable
@rendermode InteractiveServer


<PageTitle>Task Upload</PageTitle>

<div class=" mt-3">
    <div class="card">
        <div class="card-header">
            <RadzenBreadCrumb>
                <RadzenBreadCrumbItem Path="/home" Text="Home" />
                <RadzenBreadCrumbItem Path="/taskmanageradmin" Text="Task Manager" />
                <RadzenBreadCrumbItem Text="File Upload" />
            </RadzenBreadCrumb>
        </div>
        <div class="card-header">
            @if (@FileJobId > 0)
            {
                <RadzenText TextStyle="TextStyle.H5" class="rz-my-6"> 📫 Job Number @FileJobId</RadzenText>
            }
            else
            {
                <span>📭</span>
                <RadzenText TextStyle="TextStyle.H5" class="rz-my-6">  Job Number @FileJobId</RadzenText>
            }
        </div>
        <div class="card-body">

            <RadzenSteps Change=@OnChange>
                <Steps>
                    <RadzenStepsItem Text="File Upload">
                        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H3" class="rz-my-6">1. Select a file to upload and click Upload (field mapping)</RadzenText>
                        <RadzenCard Variant="Variant.Outlined">

                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Select a file to upload and click Upload</RadzenText>
                            <RadzenUpload Auto="false" Multiple="false"
                                          Change="@OnFileSelected"
                                          Style="width: 50%" />
                            <RadzenButton Text="Upload" Click=@OnUpload id="file-submit" class="rz-mt-4" />
                        </RadzenCard>
                    </RadzenStepsItem>

                    <RadzenStepsItem Text="Validate" Disabled="@(tabIndex == 1)">
                        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H3" class="rz-my-6">2. File validation results</RadzenText>
                        <RadzenButton id="CreateNewTaskButton" Icon="data_check" Text="Validate" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Size="ButtonSize.Medium"
                                      class="rz-my-1 rz-ms-1" Click="@(args => ValidateFileJob())" />

                        <RadzenStack Gap="1rem">
                            <RadzenDataGrid id="TaskmanagerTableId" @ref=@gridItemsProvider TItem="FileJobUploadDto" Data="@fileJobUploadDtoList" LoadData="@LoadData" IsLoading="@isLoading"
                                            AllowPaging="true" AllowSorting="false" PagerHorizontalAlign="HorizontalAlign.Center"
                                            PageSizeOptions="@pageSizeOptions" ShowPagingSummary="@showPagerSummary"
                                            Count="@totalItemCount">

                                <PagingSummaryTemplate>
                                    <RadzenIcon Icon="database" Style="color: var(--rz-primary); font-size: var(--rz-pager-summary-font-size);" />
                                    Displaying page @context.CurrentPage of @context.NumberOfPages <b>(total @context.TotalCount records)</b>
                                </PagingSummaryTemplate>
                                <Columns>
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.TaskTitle)" Title="TaskTitle" />
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.DueDate)" Title="DueDate" />
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.AssignedTo)" Title="AssignedTo" />
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.Title)" Title="Title" />
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.Description)" Title="Description" />
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.FileRowStatus)" Title="Status" />
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.ErrorMessage)" Title="Message" />

                                    <RadzenDataGridColumn TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                                        <Template Context="task">
                                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium"
                                                          class="rz-my-1 rz-ms-1" Click="@(async () => await EditTask(task.Id))" />
                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium"
                                                          class="rz-my-1 rz-ms-1" Click="@(() => DisableTask(task.Id))" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenStack>

                    </RadzenStepsItem>

                    <RadzenStepsItem Text="Process" Disabled="@(tabIndex == 2)">

                        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H3" class="rz-my-6">3. Process items</RadzenText>


                        <RadzenButton id="CreateNewTaskButton" Icon="rocket_launch" Text="Process" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Size="ButtonSize.Medium"
                                      class="rz-my-1 rz-ms-1" Click="@(args => ProcessFileJob())" />

                        @* <RadzenStack Gap="1rem" class="rz-m-6">
                            <RadzenProgressBar Value="156" Max="200" Unit=" process of 200" />
                        </RadzenStack> *@

                        @foreach (var rtnVall in fileJobStatus)
                        {
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.H4">@rtnVall.Key : @rtnVall.Value</RadzenText>
                        }   

                        <RadzenStack Gap="1rem">
                            <RadzenDataGrid id="TaskmanagerTableId" @ref=@gridItemsProvider TItem="FileJobUploadDto" Data="@fileJobUploadDtoList" LoadData="@LoadFinalData" IsLoading="@isLoading"
                                            AllowPaging="true" AllowSorting="false" PagerHorizontalAlign="HorizontalAlign.Center"
                                            PageSizeOptions="@pageSizeOptions" ShowPagingSummary="@showPagerSummary"
                                            Count="@totalItemCount">

                                <PagingSummaryTemplate>
                                    <RadzenIcon Icon="database" Style="color: var(--rz-primary); font-size: var(--rz-pager-summary-font-size);" />
                                    Displaying page @context.CurrentPage of @context.NumberOfPages <b>(total @context.TotalCount records)</b>
                                </PagingSummaryTemplate>
                                <Columns>
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.TaskTitle)" Title="TaskTitle" />
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.DueDate)" Title="DueDate" />
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.AssignedTo)" Title="AssignedTo" />
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.Title)" Title="Title" />
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.Description)" Title="Description" />
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.FileRowStatus)" Title="Status" />
                                    <RadzenDataGridColumn Property="@nameof(FileJobUploadDto.ErrorMessage)" Title="Message" />

                                    <RadzenDataGridColumn TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                                        <Template Context="task">
                                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium"
                                                          class="rz-my-1 rz-ms-1" Click="@(async () => await EditTask(task.Id))" />
                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium"
                                                          class="rz-my-1 rz-ms-1" Click="@(() => DisableTask(task.Id))" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenStack>

                    </RadzenStepsItem>
                </Steps>
            </RadzenSteps>

        </div>
    </div>
</div>

<RadzenCard>
    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.H4">@message</RadzenText>
</RadzenCard>

<RadzenCard>
    @foreach (var item in allRequestIds)
    {
        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.H4">@item</RadzenText>
    }
</RadzenCard>


